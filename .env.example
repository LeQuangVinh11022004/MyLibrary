VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
VITE_FILE_HASH_REGISTRY_ADDRESS=
VITE_REDIS_API_ENABLED=true

# Tùy chọn: URL CDN miễn phí (Cloudflare / GitHub Pages / jsDelivr) cho static assets
VITE_CDN_URL=

# Rate Limiting & Bảo vệ
API_RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_5MIN=8
CHALLENGE_RATE_LIMIT_PER_MIN=20
SESSIONS_RATE_LIMIT_PER_MIN=30
CACHE_MUTATE_RATE_LIMIT_PER_MIN=40
PROGRESS_RATE_LIMIT_PER_MIN=60
